# Copy this file to .env and fill in real values. Never commit .env.

# Supabase project → Settings → Database → Connection string (URI).
# Use the "Session pooler" or direct connection string; either works
# for this app's traffic level.
# Example: postgresql://postgres:your-password@db.xxxxxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.xxxxxxxx.supabase.co:5432/postgres

# Long random string used to sign Flask session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# development | production
# In production this makes session cookies HTTPS-only (Secure flag).
FLASK_ENV=development
